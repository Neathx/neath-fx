<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/gen_widget_themes.py from widget_template.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/round_22"
    android:backgroundTint="@color/p_midnight_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="36dp"
            android:background="@drawable/round_10"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/flag_from"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/flag_th" />
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/flag_scrim" />
            <TextView
                android:id="@+id/code_from"
                style="@style/FlagCode"
                android:text="THB" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="→"
            android:textColor="@color/p_midnight_dim"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="36dp"
            android:background="@drawable/round_10"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/flag_to"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/flag_ca" />
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/flag_scrim" />
            <TextView
                android:id="@+id/code_to"
                style="@style/FlagCode"
                android:text="CAD" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/btn_swap"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/oval"
            android:backgroundTint="@color/p_midnight_button"
            android:contentDescription="@string/swap"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap"
            android:tint="@color/p_midnight_icon" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/oval"
            android:backgroundTint="@color/p_midnight_button"
            android:contentDescription="@string/refresh"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh"
            android:tint="@color/p_midnight_icon" />
    </LinearLayout>

    <TextView
        android:id="@+id/rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:text="1 THB = 0.0400 CAD"
        android:textColor="@color/p_midnight_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/round_14"
        android:backgroundTint="@color/p_midnight_table"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <LinearLayout style="@style/WidgetRow">
            <TextView android:id="@+id/amt1" style="@style/WidgetAmount" android:textColor="@color/p_midnight_dim" android:text="100 THB" />
            <TextView android:id="@+id/val1" style="@style/WidgetValue" android:textColor="@color/p_midnight_accent" android:text="4.00 CAD" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetRow">
            <TextView android:id="@+id/amt2" style="@style/WidgetAmount" android:textColor="@color/p_midnight_dim" android:text="500 THB" />
            <TextView android:id="@+id/val2" style="@style/WidgetValue" android:textColor="@color/p_midnight_accent" android:text="20.00 CAD" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetRow">
            <TextView android:id="@+id/amt3" style="@style/WidgetAmount" android:textColor="@color/p_midnight_dim" android:text="1,000 THB" />
            <TextView android:id="@+id/val3" style="@style/WidgetValue" android:textColor="@color/p_midnight_accent" android:text="40.00 CAD" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetRow">
            <TextView android:id="@+id/amt4" style="@style/WidgetAmount" android:textColor="@color/p_midnight_dim" android:text="5,000 THB" />
            <TextView android:id="@+id/val4" style="@style/WidgetValue" android:textColor="@color/p_midnight_accent" android:text="200.00 CAD" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:text="Tap to convert any amount"
        android:textColor="@color/p_midnight_faint"
        android:textSize="11sp" />
</LinearLayout>
