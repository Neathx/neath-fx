<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calc_title"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <ImageButton
                android:id="@+id/btn_theme"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/theme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_palette"
                android:tint="?android:attr/textColorPrimary" />
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:tint="?android:attr/textColorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_from"
                android:layout_width="120dp"
                android:layout_height="64dp"
                android:background="@drawable/round_14"
                android:backgroundTint="#22888888"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:contentDescription="@string/choose_currency">
                <ImageView
                    android:id="@+id/flag_from"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/flag_scrim" />
                <TextView
                    android:id="@+id/code_from"
                    style="@style/FlagCode"
                    android:textSize="20sp" />
            </FrameLayout>

            <EditText
                android:id="@+id/edit_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:digits="0123456789.,"
                android:gravity="end"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:selectAllOnFocus="true"
                android:textSize="26sp" />

            <ImageButton
                android:id="@+id/clear_from"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:alpha="0.55"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clear"
                android:tint="?android:attr/textColorPrimary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_swap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="38dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/swap"
            android:padding="10dp"
            android:rotation="90"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_swap"
            android:tint="?android:attr/textColorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_to"
                android:layout_width="120dp"
                android:layout_height="64dp"
                android:background="@drawable/round_14"
                android:backgroundTint="#22888888"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:contentDescription="@string/choose_currency">
                <ImageView
                    android:id="@+id/flag_to"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/flag_scrim" />
                <TextView
                    android:id="@+id/code_to"
                    style="@style/FlagCode"
                    android:textSize="20sp" />
            </FrameLayout>

            <EditText
                android:id="@+id/edit_to"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:digits="0123456789.,"
                android:gravity="end"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:selectAllOnFocus="true"
                android:textSize="26sp" />

            <ImageButton
                android:id="@+id/clear_to"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:alpha="0.55"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clear"
                android:tint="?android:attr/textColorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.5"
            android:autoLink="web"
            android:text="@string/attribution"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
